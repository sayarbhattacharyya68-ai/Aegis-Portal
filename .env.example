# Google Gemini Developer API key. Keep the real value in your local .env only.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash

# A long random administrator secret. Never commit the real value.
ADMIN_KEY=replace_with_a_long_random_admin_secret
ADMIN_CONTACT=

# Private Credit-Bay configuration. Leave blank until configured by the owner.
PAYMENT_RECIPIENT_NAME=
PAYMENT_RECIPIENT_VPA=
PAYMENT_QR_IMAGE=my_upi_qr.jpeg

# Local data settings. Defaults are relative to the project directory.
AEGIS_DB_PATH=
AUDIT_UPLOAD_DIR=audit_screenshots
SCREENSHOT_RETENTION_DAYS=30