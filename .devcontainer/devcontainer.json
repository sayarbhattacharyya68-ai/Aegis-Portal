{
  "name": "Aegis-Portal Python 3.11",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "main.py"]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
  "postAttachCommand": {
    "server": "streamlit run main.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "Aegis-Portal",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501]
}